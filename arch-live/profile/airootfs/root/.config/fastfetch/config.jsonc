{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "white",
      "2": "white",
      "3": "white",
      "4": "white",
      "5": "white",
      "6": "white",
      "7": "white",
      "8": "white",
      "9": "white"
    },
    "padding": {
      "top": 0,
      "left": 0,
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "white",
      "title": "white",
      "output": "white",
      "separator": "white"
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "white",
        "at": "white",
        "host": "white"
      }
    },

    {
      "type": "separator",
      "string": "────────────"
    },

    {
      "type": "os",
      "key": "System"
    },

    {
      "type": "host",
      "key": "Machine"
    },

    {
      "type": "kernel",
      "key": "Kernel"
    },

    {
      "type": "uptime",
      "key": "Uptime"
    },

    {
      "type": "packages",
      "key": "Packages"
    },

    {
      "type": "shell",
      "key": "Shell"
    },

    {
      "type": "terminal",
      "key": "Terminal"
    },

    {
      "type": "de",
      "key": "Desktop"
    },

    {
      "type": "wm",
      "key": "Window Mgr"
    },

    {
      "type": "cpu",
      "key": "CPU"
    },

    {
      "type": "gpu",
      "key": "GPU"
    },

    {
      "type": "memory",
      "key": "Memory"
    },

    {
      "type": "swap",
      "key": "Swap"
    },

    {
      "type": "disk",
      "key": "Live Root",
      "folders": "/"
    },

    {
      "type": "localip",
      "key": "Local IP",
      "showIpv6": false
    },

    {
      "type": "battery",
      "key": "Battery"
    },

    {
      "type": "locale",
      "key": "Locale"
    }
  ]
}
